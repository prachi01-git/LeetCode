class Solution {
public:
    bool isAnagram(string s, string t) {
        if(s.length() != t.length()) return false;
        map<char,int> charCount;

        for(int i=0; i<s.length(); i++){
            charCount[s[i]]++;
        }
        for(int i=0; i<t.length(); i++){
            charCount[t[i]]--;
        }
        for(auto pair : charCount){
            if(pair.second !=0){
                return false;
            }
        }
        return true;
    }
};
