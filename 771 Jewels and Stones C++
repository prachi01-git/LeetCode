class Solution {
public:
    int numJewelsInStones(string jewels, string stones) {
        unordered_map<char, int> s;

        for(int i=0 ; i<stones.length() ; i++){
            s[stones[i]]++;
        }
        int total=0;
        for(int i=0 ; i<jewels.length() ; i++){
            char current_jewel = jewels[i];
            total = total+ s[current_jewel];
        }
        return total;
    }
};
