class Solution {
public:
    int removeDuplicates(vector<int>& nums) {
      if(nums.empty()){
        return 0;
      }
      int insert_idx=1;
      for(int i=1;i<nums.size();i++){
        if(nums[i]!=nums[i-1]){
            nums[insert_idx]=nums[i];
            insert_idx++;
        }
      }
    
return insert_idx;

        }

    };
