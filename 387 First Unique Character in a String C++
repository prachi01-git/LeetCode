class Solution {
public:
    int firstUniqChar(string s) {
        unordered_map<char, int> mpp;
        for(int i=0 ; i<s.length() ; i++){
            mpp[s[i]]++;
        }
        for(int i=0 ; i<s.length() ; i++){
            char current_char = s[i];
             
             if(mpp[current_char] == 1){
                return i;
             }
        
        }
        return -1;
    }
};
